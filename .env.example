# =============================================================================
# Hound SaaS Stack - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# Usage: cp .env.example .env && edit .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=hound
POSTGRES_PASSWORD=hound_secret_change_me
POSTGRES_DB=hound

# Full connection URL (constructed from above or override directly)
DATABASE_URL=postgresql://hound:hound_secret_change_me@db:5432/hound

# -----------------------------------------------------------------------------
# Redis Configuration (Celery Broker + Pub/Sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# LLM API Keys (at least one required for audits)
# -----------------------------------------------------------------------------
# OpenAI (GPT-4, GPT-4o, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Google (Gemini) - for API access
GOOGLE_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub App Integration (required for PR bot)
# -----------------------------------------------------------------------------
# Your GitHub App ID (found in App settings)
GITHUB_APP_ID=

# Webhook secret for verifying GitHub payloads
GITHUB_WEBHOOK_SECRET=

# Private key - provide EITHER the key content OR a path to the file
# Option 1: Key content directly (useful for containers/secrets)
GITHUB_APP_PRIVATE_KEY=

# Option 2: Path to the .pem file
GITHUB_APP_PRIVATE_KEY_PATH=

# Personal Access Token (alternative to App for some operations)
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# GitHub OAuth (for user authentication with JWT)
# -----------------------------------------------------------------------------
# Create at https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Google OAuth (for user authentication)
# -----------------------------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# S3/MinIO Cloud Storage (optional - for artifact persistence)
# -----------------------------------------------------------------------------
# AWS credentials (or MinIO credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 bucket for storing session data and graphs
S3_BUCKET=hound-artifacts
S3_PREFIX=

# Custom endpoint for MinIO or S3-compatible services
# Example: http://minio:9000
S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Admin Panel
# -----------------------------------------------------------------------------
# Admin API key for admin endpoints (set to enable admin auth)
HOUND_ADMIN_KEY=

# Session signing secret for SQLAdmin (REQUIRED when HOUND_ADMIN_KEY is set)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HOUND_SECRET_KEY=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Config file path override
HOUND_CONFIG=

# Registry directory for session state
HOUND_REGISTRY_DIR=

# Debug log directory
HOUND_DEBUG_DIR=

# -----------------------------------------------------------------------------
# Chatbot Server (optional - for chatbot/run.py)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5280
FLASK_DEBUG=0

# -----------------------------------------------------------------------------
# Telegram Notifications
# -----------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID for the notification channel/group (negative number for groups)
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API server URL for the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (no spaces)
# For local development:
ALLOWED_ORIGINS=http://localhost:3000

# For production (specify exact domains):
# ALLOWED_ORIGINS=https://app.firepan.com,https://dev.firepan.com

# Security Notes:
# - NEVER use "*" in production
# - Always specify exact domains with protocol (http:// or https://)
# - Do not include trailing slashes

# -----------------------------------------------------------------------------
# x402 Agent Payments (USDC on Base)
# -----------------------------------------------------------------------------
# Enable/disable x402 payment gate
X402_ENABLED=false

# USDC receiving address (EOA or multi-sig)
X402_WALLET_ADDRESS=

# Facilitator URL
# Testnet (no API key needed): https://x402.org/facilitator
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=https://x402.org/facilitator

# Network identifier
# Base Sepolia testnet: eip155:84532
# Base mainnet: eip155:8453
X402_NETWORK=eip155:84532

# Daily spend cap for free teaser scans (USD)
X402_FREE_SCAN_DAILY_BUDGET_USD=25

# CDP API credentials (required for mainnet facilitator only)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# =============================================================================
# Docker Compose Notes:
# - db, redis, api, worker services share 'hound-net' network
# - Service hostnames: db, redis, api, worker
# - Internal ports: PostgreSQL=5432, Redis=6379, API=8000
# =============================================================================
