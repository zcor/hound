# Hound Default Configuration
# Gemini for graph building (fast + cheap), OpenAI for analysis

openai:
  api_key_env: OPENAI_API_KEY
gemini:
  api_key_env: GOOGLE_API_KEY
  vertex_ai:
    enabled: false
    project_id: ''
    region: ''
anthropic:
  api_key_env: ANTHROPIC_API_KEY
xai:
  api_key_env: XAI_API_KEY
rei:
  api_key_env: REI_API_KEY
  base_url: https://api.reilabs.org
  endpoint: /v1/chat/completions
deepseek:
  api_key_env: DEEPSEEK_API_KEY
  base_url: https://api.deepseek.com

models:
  graph:
    provider: gemini
    model: gemini-2.5-pro
    max_context: 1000000
    thinking_enabled: true
    thinking_budget: -1
  scout:
    provider: openai
    model: gpt-5-mini
    max_context: 256000
  strategist:
    provider: openai
    model: gpt-5-mini
    max_context: 256000
    plan_reasoning_effort: medium
    hypothesize_reasoning_effort: high
  lightweight:
    provider: openai
    model: gpt-4o-mini
  finalize:
    provider: openai
    model: gpt-5-mini
    reasoning_effort: high
  reporting:
    provider: openai
    model: gpt-4o
  math:
    provider: rei
    model: math
    max_context: 256000
    plan_reasoning_effort: high
    hypothesize_reasoning_effort: high

context:
  max_tokens: 256000
  compression_threshold: 0.75

timeouts:
  request_seconds: 300

retries:
  max_attempts: 3
  backoff_min_seconds: 1
  backoff_max_seconds: 2
