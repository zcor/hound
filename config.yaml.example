# Hound Default Configuration - GPT-5-mini (Recommended)
# Best cost-to-quality ratio: ~$0.06 per graph build, 14 min for 3 graphs
#
# Model Comparison (January 2026 benchmarks):
#   GPT-5-mini:     14.4 min, ~$0.06 ← RECOMMENDED (best cost/quality)
#   Gemini 2.5:     ~9 min, ~$0.30 (fastest but 5x cost)
#   Hybrid mode:    ~10 min, ~$0.10 (Gemini discovery + DeepSeek build)
#   DeepSeek Chat:  ~168 min, ~$0.05 (cheapest but very slow)

openai:
  api_key_env: OPENAI_API_KEY
gemini:
  api_key_env: GOOGLE_API_KEY
  vertex_ai:
    enabled: false
    project_id: ''
    region: ''
anthropic:
  api_key_env: ANTHROPIC_API_KEY
deepseek:
  api_key_env: DEEPSEEK_API_KEY
  base_url: https://api.deepseek.com

models:
  graph:
    provider: openai
    model: gpt-5-mini
    max_context: 128000
  scout:
    provider: openai
    model: gpt-5-mini
    max_context: 128000
  strategist:
    provider: openai
    model: gpt-5-mini
    max_context: 128000
  lightweight:
    provider: openai
    model: gpt-4o-mini
  finalize:
    provider: openai
    model: gpt-5-mini
  reporting:
    provider: openai
    model: gpt-4o
  # Single-auditor pipeline (mode=auditor): strong reasoning model + fp-check gates
  auditor:
    provider: anthropic
    model: claude-sonnet-4-20250514
    max_context: 200000
    temperature: 0.1
  # Optional: Math reasoning (requires REI API)
  # math:
  #   provider: rei
  #   model: math
  #   max_context: 256000
  # Adversarial verifier for the per-pattern template FP filter (firepan-8kv).
  # MUST differ from scout/strategist provider+model, else the gate skips itself.
  template_verifier:
    provider: anthropic
    model: claude-sonnet-4-6
    max_context: 32000

# Deep audit feature flags
deep_audit_template_fp_filter: true  # firepan-8kv: drop template-FP access-control hypotheses
deep_audit_symbol_exists_gate: true  # firepan-apn: reject hypotheses citing symbols not in repo

context:
  max_tokens: 128000
  compression_threshold: 0.75

timeouts:
  request_seconds: 300

retries:
  max_attempts: 3
  backoff_min_seconds: 1
  backoff_max_seconds: 2

# Claude Code CLI orchestration — used when mode=auditor and `claude` is on $PATH.
# When available, the auditor spawns autonomous Claude CLI sessions with full
# tool access (file ops, bash, Slither, Foundry, Trail of Bits plugins, Pashov skills).
# Required for mode=auditor — SingleAuditor hard-fails if `claude` is missing
# (use mode=sweep/intuition or install via scripts/setup-server.sh).
claude_cli:
  # path: claude                       # Path to the `claude` executable
  max_turns: 50                        # Max tool-use turns per audit session
  timeout: 900                         # Per-session timeout in seconds (15 min)
  skip_permissions: true               # Use --dangerously-skip-permissions for automation
  fp_check_max_turns: 30               # Max turns for fp-check verification sessions
  fp_check_timeout: 600                # Timeout for fp-check sessions (10 min)
  # model: claude-sonnet-4-20250514    # Override model (defaults to auditor profile model)
  # allowed_tools:                     # Restrict to specific tools (default: all)
  #   - Read
  #   - Write
  #   - Bash
  #   - Glob
  #   - Grep
  # mcp_config: /path/to/mcp-servers.json  # MCP server config file (optional)

# Use fp-check CLI + Trail of Bits plugin cross-check when available.
# When true, fp-check runs natively first, then cross-checks with
# `claude plugin run fp-check` for secondary validation.
fp_check_cli_fallback: true
