# Hound Default Configuration - GPT-5-mini (Recommended)
# Best cost-to-quality ratio: ~$0.06 per graph build, 14 min for 3 graphs
#
# Model Comparison (January 2026 benchmarks):
#   GPT-5-mini:     14.4 min, ~$0.06 ← RECOMMENDED (best cost/quality)
#   Gemini 2.5:     ~9 min, ~$0.30 (fastest but 5x cost)
#   Hybrid mode:    ~10 min, ~$0.10 (Gemini discovery + DeepSeek build)
#   DeepSeek Chat:  ~168 min, ~$0.05 (cheapest but very slow)

openai:
  api_key_env: OPENAI_API_KEY
gemini:
  api_key_env: GOOGLE_API_KEY
  vertex_ai:
    enabled: false
    project_id: ''
    region: ''
anthropic:
  api_key_env: ANTHROPIC_API_KEY
deepseek:
  api_key_env: DEEPSEEK_API_KEY
  base_url: https://api.deepseek.com

models:
  graph:
    provider: openai
    model: gpt-5-mini
    max_context: 128000
  scout:
    provider: openai
    model: gpt-5-mini
    max_context: 128000
  strategist:
    provider: openai
    model: gpt-5-mini
    max_context: 128000
  lightweight:
    provider: openai
    model: gpt-4o-mini
  finalize:
    provider: openai
    model: gpt-5-mini
  reporting:
    provider: openai
    model: gpt-4o
  # Optional: Math reasoning (requires REI API)
  # math:
  #   provider: rei
  #   model: math
  #   max_context: 256000

context:
  max_tokens: 128000
  compression_threshold: 0.75

timeouts:
  request_seconds: 300

retries:
  max_attempts: 3
  backoff_min_seconds: 1
  backoff_max_seconds: 2
